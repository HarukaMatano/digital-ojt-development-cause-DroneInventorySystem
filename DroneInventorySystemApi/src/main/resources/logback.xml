<configuration>
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>C:/logs/dojt_api/dojt_log_%d{yyyyMMdd}.txt</fileNamePattern>
            <maxHistory>180</maxHistory> <!-- ログの保持期間を180日（6ヶ月）に設定 -->
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %X{IP} %X{userID} %X{screen} %X{method} %X{result} %X{operation} %X{target} %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE" />
    </appender>

    <!-- INFOレベル以上のログを出力 -->
    <logger name="com.digitalojt" level="INFO" additivity="false">
        <appender-ref ref="ASYNC" />
    </logger>

    <!-- DEBUGレベル以上のログを出力 -->
    <logger name="com.digitalojt.debug" level="DEBUG" additivity="false">
        <appender-ref ref="ASYNC" />
    </logger>

    <!-- WARNレベル以上のログを出力 -->
    <logger name="com.digitalojt.warn" level="WARN" additivity="false">
        <appender-ref ref="ASYNC" />
    </logger>

    <!-- ERRORレベル以上のログを出力 -->
    <logger name="com.digitalojt.error" level="ERROR" additivity="false">
        <appender-ref ref="ASYNC" />
    </logger>

    <root level="INFO">
        <appender-ref ref="ASYNC" />
    </root>
</configuration>